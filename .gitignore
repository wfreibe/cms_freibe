# Dependencies
node_modules/
*/node_modules/
vendor/
package-lock.json.backup

# Production and local database files (Strictly excluded)
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.db
*.db-wal
*.db-shm
*.db-journal
*.db-*
